// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
/*
 * Xiaomi Router BE18000 Pro Max (hardware-converted BE10000)
 *
 * The running QWRT 5.4.250 system identifies this unit as
 * "xiaomi,be18000".  Keep that first compatible string: it is the
 * OpenWrt board name used by 02_network, platform.sh and the ath12k
 * calibration/board selection.
 *
 * This board file starts with the boot-critical UART, clocks, NAND and
 * board I/O.  The QCA8084/AQR Ethernet and the three QCN9224 radios are
 * staged separately so a radio or PHY failure cannot take away the
 * serial/management path.
 */

/dts-v1/;

#include <dt-bindings/clock/qcom,qca8k-nsscc.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/net/qcom,qca808x.h>
#include <dt-bindings/reset/qcom,qca8k-nsscc.h>
#include "ipq9574.dtsi"

/ {
	model = "Xiaomi BE18000";
	compatible = "xiaomi,be18000", "qcom,ipq9574-ap-al02-c4", "qcom,ipq9574";

	aliases {
		led-boot = &led_sys_orange;
		led-failsafe = &led_sys_orange;
		led-running = &led_sys_white;
		led-upgrade = &led_sys_white;

		serial0 = &blsp1_uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";

		/*
		 * The fork's generic 6.18 command-line hack appends this to
		 * the bootloader command line.  The UBI volume IDs are
		 * verified against the generated factory image before the
		 * first NAND boot; an initramfs boot still runs its own
		 * /init and does not need this argument.
		 */
		bootargs-append = " root=/dev/ubiblock0_1";
	};

	/*
	 * QCA8084 NSSCC reference clocks.  The upstream clock driver
	 * expects seven parents; these are the documented 25 MHz XO and
	 * 125/312.5 MHz SerDes references.  The exact board frequencies
	 * remain a Phase B scope/hardware check.
	 */
	qca8k_xo: qca8k-xo {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <25000000>;
	};

	qca8k_uniphy0_rx: qca8k-uniphy0-rx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};

	qca8k_uniphy0_tx: qca8k-uniphy0-tx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};

	qca8k_uniphy1_rx: qca8k-uniphy1-rx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};

	qca8k_uniphy1_tx: qca8k-uniphy1-tx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};

	qca8k_uniphy1_rx312p5m: qca8k-uniphy1-rx312p5m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};

	qca8k_uniphy1_tx312p5m: qca8k-uniphy1-tx312p5m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};

	reserved-memory {
		/*
		 * QCN9224 host DDR windows from the live QWRT DT.  Each
		 * radio owns 50 MiB; the caldb window is the upper 8 MiB
		 * at +0x1e00000 and is described only when the cold-boot
		 * handshake is implemented.
		 */
		qcn9224_pcie1: qcn9224-pcie1@50f00000 {
			reg = <0x0 0x50f00000 0x0 0x3200000>;
			no-map;
		};

		qcn9224_pcie2: qcn9224-pcie2@54100000 {
			reg = <0x0 0x54100000 0x0 0x3200000>;
			no-map;
		};

		qcn9224_pcie3: qcn9224-pcie3@57300000 {
			reg = <0x0 0x57300000 0x0 0x3200000>;
			no-map;
		};

		m3_dump: m3-dump@4d600000 {
			reg = <0x0 0x4d600000 0x0 0x100000>;
			no-map;
		};

		q6_etr_dump: q6-etr-dump@4d700000 {
			reg = <0x0 0x4d700000 0x0 0x100000>;
			no-map;
		};

		/*
		 * Use the disabled qcn9224_pcie0 window for pstore.  Keep
		 * this reservation clear of the active QCN9224 windows and
		 * verify it against /proc/iomem before enabling pstore in a
		 * production image.
		 */
		ramoops@4dd00000 {
			compatible = "ramoops";
			reg = <0x0 0x4dd00000 0x0 0x400000>;
			record-size = <0x20000>;
			console-size = <0x20000>;
			pmsg-size = <0x20000>;
			ftrace-size = <0x20000>;
			no-map;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		mesh {
			label = "mesh";
			linux,code = <0x109>; /* BTN_9, live QWRT code */
			gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			debounce-interval = <60>;
		};

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 45 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			debounce-interval = <60>;
		};
	};

	leds-gpio {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_sys_white: sys-white {
			label = "sys_white";
			gpios = <&tlmm 40 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_sys_orange: sys-orange {
			label = "sys_orange";
			gpios = <&tlmm 41 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_net_white: net-white {
			label = "net_white";
			gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_net_orange: net-orange {
			label = "net_orange";
			gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_sfp_green: sfp-green {
			label = "sfp_green";
			gpios = <&tlmm 62 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "netdev";
			default-state = "off";
		};
	};

	leds-pwm {
		compatible = "pwm-leds";
		pinctrl-0 = <&pwm_pins>;
		pinctrl-names = "default";

		led_rgb_red: rgb-red {
			label = "rgb:red";
			color = <LED_COLOR_ID_RED>;
			pwms = <&pwm 3 51000 0>;
			max-brightness = <255>;
		};

		led_rgb_green: rgb-green {
			label = "rgb:green";
			color = <LED_COLOR_ID_GREEN>;
			pwms = <&pwm 2 51000 0>;
			max-brightness = <255>;
		};

		led_rgb_blue: rgb-blue {
			label = "rgb:blue";
			color = <LED_COLOR_ID_BLUE>;
			pwms = <&pwm 1 51000 0>;
			max-brightness = <255>;
		};
	};
};

&blsp1_uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&sleep_clk {
	clock-frequency = <32000>;
};

&rpm_requests {
	regulators {
		compatible = "qcom,rpm-mp5496-regulators";

		ipq9574_s1: s1 {
			/*
			 * The bootloader leaves the CPU rail at the SVS
			 * voltage. Keep the minimum at 725 mV so regulator
			 * registration does not briefly request the lowest
			 * supported voltage.
			 */
			regulator-min-microvolt = <725000>;
			regulator-max-microvolt = <1075000>;
		};
	};
};

&xo_clk {
	clock-frequency = <48000000>;
};

&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <1>;
};

&xo_board_clk {
	clock-div = <2>;
	clock-mult = <1>;
};

&pwm {
	pinctrl-0 = <&pwm_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_snand_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;

		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x180000>;
				read-only;
			};

			partition@180000 {
				label = "0:SBL1_1";
				reg = <0x180000 0x180000>;
				read-only;
			};

			partition@300000 {
				label = "0:MIBIB";
				reg = <0x300000 0x100000>;
				read-only;
			};

			partition@400000 {
				label = "0:BOOTCONFIG";
				reg = <0x400000 0x80000>;
				read-only;
			};

			partition@480000 {
				label = "0:BOOTCONFIG1";
				reg = <0x480000 0x80000>;
				read-only;
			};

			partition@500000 {
				label = "0:QSEE";
				reg = <0x500000 0x380000>;
				read-only;
			};

			partition@880000 {
				label = "0:QSEE_1";
				reg = <0x880000 0x380000>;
				read-only;
			};

			partition@c00000 {
				label = "0:DEVCFG";
				reg = <0xc00000 0x80000>;
				read-only;
			};

			partition@c80000 {
				label = "0:DEVCFG_1";
				reg = <0xc80000 0x80000>;
				read-only;
			};

			partition@d00000 {
				label = "0:APDP";
				reg = <0xd00000 0x80000>;
				read-only;
			};

			partition@d80000 {
				label = "0:APDP_1";
				reg = <0xd80000 0x80000>;
				read-only;
			};

			partition@e00000 {
				label = "0:TME";
				reg = <0xe00000 0x80000>;
				read-only;
			};

			partition@e80000 {
				label = "0:TME_1";
				reg = <0xe80000 0x80000>;
				read-only;
			};

			partition@f00000 {
				label = "0:RPM";
				reg = <0xf00000 0x80000>;
				read-only;
			};

			partition@f80000 {
				label = "0:RPM_1";
				reg = <0xf80000 0x80000>;
				read-only;
			};

			partition@1000000 {
				label = "0:CDT";
				reg = <0x1000000 0x80000>;
				read-only;
			};

			partition@1080000 {
				label = "0:CDT_1";
				reg = <0x1080000 0x80000>;
				read-only;
			};

			partition@1100000 {
				label = "0:APPSBLENV";
				reg = <0x1100000 0x80000>;
			};

			partition@1180000 {
				label = "0:APPSBL";
				reg = <0x1180000 0x180000>;
				read-only;
			};

			partition@1300000 {
				label = "0:APPSBL_1";
				reg = <0x1300000 0x180000>;
				read-only;
			};

			partition@1480000 {
				label = "0:ART";
				reg = <0x1480000 0x140000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					ethaddr: ethaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@15c0000 {
				label = "0:ETHPHYFW";
				reg = <0x15c0000 0x100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					aqr_fw: aqr-fw@28 {
						reg = <0x28 0x60002>;
					};
				};
			};

			partition@16c0000 {
				label = "0:TRAINING";
				reg = <0x16c0000 0x80000>;
				read-only;
			};

			partition@1740000 {
				label = "0:LICENSE";
				reg = <0x1740000 0x40000>;
				read-only;
			};

			partition@1780000 {
				label = "rootfs";
				reg = <0x1780000 0xbe00000>;
				linux,rootfs;
			};

			partition@d580000 {
				label = "bdata";
				reg = <0xd580000 0x40000>;
				read-only;
			};

			partition@d5c0000 {
				label = "crash";
				reg = <0xd5c0000 0x40000>;
				read-only;
			};

			partition@d600000 {
				label = "crash_syslog";
				reg = <0xd600000 0x40000>;
				read-only;
			};
		};
	};
};

&mdio {
	status = "okay";

	/*
	 * The QCA8084 package contains the PHY clock/reset controller.
	 * It owns the shared package reset GPIO; do not also put
	 * reset-gpios on the MDIO bus or the package node.
	 */
	qca8084_nsscc: clock-controller@18 {
		compatible = "qcom,qca8084-nsscc";
		reg = <0x18>;
		reset-gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;
		clocks = <&qca8k_xo>,
			 <&qca8k_uniphy0_rx>,
			 <&qca8k_uniphy0_tx>,
			 <&qca8k_uniphy1_rx>,
			 <&qca8k_uniphy1_tx>,
			 <&qca8k_uniphy1_rx312p5m>,
			 <&qca8k_uniphy1_tx312p5m>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
	};

	ethernet-phy-package@1 {
		compatible = "qcom,qca8084-package";
		reg = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		qcom,package-mode = <QCA808X_PCS1_10G_QXGMII_PCS0_UNUNSED>;
		qcom,phy-addr-fixup = <1 2 3 4 5 6 7>;

		clocks = <&qca8084_nsscc NSS_CC_APB_BRIDGE_CLK>,
			 <&qca8084_nsscc NSS_CC_AHB_CLK>,
			 <&qca8084_nsscc NSS_CC_SEC_CTRL_AHB_CLK>,
			 <&qca8084_nsscc NSS_CC_TLMM_CLK>,
			 <&qca8084_nsscc NSS_CC_TLMM_AHB_CLK>,
			 <&qca8084_nsscc NSS_CC_CNOC_AHB_CLK>,
			 <&qca8084_nsscc NSS_CC_MDIO_AHB_CLK>;
		clock-names = "apb_bridge", "ahb", "sec_ctrl_ahb",
			      "tlmm", "tlmm_ahb", "cnoc_ahb", "mdio_ahb";
		resets = <&qca8084_nsscc NSS_CC_GEPHY_FULL_ARES>;

		qca8084_phy1: ethernet-phy@1 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <1>;
			clocks = <&qca8084_nsscc NSS_CC_GEPHY0_SYS_CLK>;
			resets = <&qca8084_nsscc NSS_CC_GEPHY0_SYS_ARES>;
			qcom,xpcs-channel = <0>;
		};

		qca8084_phy2: ethernet-phy@2 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <2>;
			clocks = <&qca8084_nsscc NSS_CC_GEPHY1_SYS_CLK>;
			resets = <&qca8084_nsscc NSS_CC_GEPHY1_SYS_ARES>;
			qcom,xpcs-channel = <1>;
		};

		qca8084_phy3: ethernet-phy@3 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <3>;
			clocks = <&qca8084_nsscc NSS_CC_GEPHY2_SYS_CLK>;
			resets = <&qca8084_nsscc NSS_CC_GEPHY2_SYS_ARES>;
			qcom,xpcs-channel = <2>;
		};

		qca8084_phy4: ethernet-phy@4 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <4>;
			clocks = <&qca8084_nsscc NSS_CC_GEPHY3_SYS_CLK>;
			resets = <&qca8084_nsscc NSS_CC_GEPHY3_SYS_ARES>;
			qcom,xpcs-channel = <3>;
		};

		pcs-phy@6 {
			compatible = "qcom,qca8k-pcs-phy";
			reg = <6>;
			clocks = <&qca8084_nsscc NSS_CC_SRDS1_SYS_CLK>,
				 <&qca8k_uniphy1_tx312p5m>,
				 <&qca8k_uniphy1_rx312p5m>;
			clock-names = "pcs", "pcs_rx_root", "pcs_tx_root";
			resets = <&qca8084_nsscc NSS_CC_SRDS1_SYS_ARES>;
		};

		xpcs-phy@7 {
			compatible = "qcom,qca8k-xpcs-phy";
			reg = <7>;
			#address-cells = <1>;
			#size-cells = <0>;
			resets = <&qca8084_nsscc NSS_CC_XPCS_ARES>;

			channel@0 {
				reg = <0>;
				clocks = <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_XGMII_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_XGMII_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_GEPHY0_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_GEPHY0_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_RX_CLK_SRC>,
					 <&qca8084_nsscc NSS_CC_MAC1_TX_CLK_SRC>;
				clock-names = "xgmii_rx", "xgmii_tx",
					      "xpcs_rx", "xpcs_tx",
					      "port_rx", "port_tx",
					      "rx_src", "tx_src";
				resets = <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_XGMII_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_XGMII_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_GEPHY0_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_GEPHY0_TX_ARES>;
				reset-names = "xgmii_rx", "xgmii_tx",
					      "xpcs_rx", "xpcs_tx",
					      "port_rx", "port_tx";
			};

			channel@1 {
				reg = <1>;
				clocks = <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_XGMII_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_XGMII_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_GEPHY1_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_GEPHY1_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_RX_CLK_SRC>,
					 <&qca8084_nsscc NSS_CC_MAC2_TX_CLK_SRC>;
				clock-names = "xgmii_rx", "xgmii_tx",
					      "xpcs_rx", "xpcs_tx",
					      "port_rx", "port_tx",
					      "rx_src", "tx_src";
				resets = <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_XGMII_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_XGMII_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_GEPHY1_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_GEPHY1_TX_ARES>;
				reset-names = "xgmii_rx", "xgmii_tx",
					      "xpcs_rx", "xpcs_tx",
					      "port_rx", "port_tx";
			};

			channel@2 {
				reg = <2>;
				clocks = <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_XGMII_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_XGMII_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_GEPHY2_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_GEPHY2_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_RX_CLK_SRC>,
					 <&qca8084_nsscc NSS_CC_MAC3_TX_CLK_SRC>;
				clock-names = "xgmii_rx", "xgmii_tx",
					      "xpcs_rx", "xpcs_tx",
					      "port_rx", "port_tx",
					      "rx_src", "tx_src";
				resets = <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_XGMII_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_XGMII_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_GEPHY2_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_GEPHY2_TX_ARES>;
				reset-names = "xgmii_rx", "xgmii_tx",
					      "xpcs_rx", "xpcs_tx",
					      "port_rx", "port_tx";
			};

			channel@3 {
				reg = <3>;
				clocks = <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_XGMII_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_XGMII_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_GEPHY3_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_GEPHY3_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_RX_CLK_SRC>,
					 <&qca8084_nsscc NSS_CC_MAC4_TX_CLK_SRC>;
				clock-names = "xgmii_rx", "xgmii_tx",
					      "xpcs_rx", "xpcs_tx",
					      "port_rx", "port_tx",
					      "rx_src", "tx_src";
				resets = <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_XGMII_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_XGMII_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_GEPHY3_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_GEPHY3_TX_ARES>;
				reset-names = "xgmii_rx", "xgmii_tx",
					      "xpcs_rx", "xpcs_tx",
					      "port_rx", "port_tx";
			};
		};
	};

	aqr113c: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0>;
		nvmem-cells = <&aqr_fw>;
		nvmem-cell-names = "firmware";
	};
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			phy-mode = "10g-qxgmii";
			phy-handle = <&qca8084_phy1>;
			pcs-handle = <&pcs0_ch0>;
			managed = "in-band-status";
			label = "lan1";

			nvmem-cells = <&ethaddr 1>;
			nvmem-cell-names = "mac-address";

			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac", "rx", "tx";

			resets = <&nsscc PORT1_MAC_ARES>,
				 <&nsscc PORT1_RX_ARES>,
				 <&nsscc PORT1_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@2 {
			reg = <2>;
			phy-mode = "10g-qxgmii";
			phy-handle = <&qca8084_phy2>;
			pcs-handle = <&pcs0_ch1>;
			managed = "in-band-status";
			label = "lan2";

			nvmem-cells = <&ethaddr 1>;
			nvmem-cell-names = "mac-address";

			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac", "rx", "tx";

			resets = <&nsscc PORT2_MAC_ARES>,
				 <&nsscc PORT2_RX_ARES>,
				 <&nsscc PORT2_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@3 {
			reg = <3>;
			phy-mode = "10g-qxgmii";
			phy-handle = <&qca8084_phy3>;
			pcs-handle = <&pcs0_ch2>;
			managed = "in-band-status";
			label = "lan3";

			nvmem-cells = <&ethaddr 1>;
			nvmem-cell-names = "mac-address";

			clocks = <&nsscc NSS_CC_PORT3_MAC_CLK>,
				 <&nsscc NSS_CC_PORT3_RX_CLK>,
				 <&nsscc NSS_CC_PORT3_TX_CLK>;
			clock-names = "mac", "rx", "tx";

			resets = <&nsscc PORT3_MAC_ARES>,
				 <&nsscc PORT3_RX_ARES>,
				 <&nsscc PORT3_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@4 {
			reg = <4>;
			phy-mode = "10g-qxgmii";
			phy-handle = <&qca8084_phy4>;
			pcs-handle = <&pcs0_ch3>;
			managed = "in-band-status";
			label = "lan4";

			nvmem-cells = <&ethaddr 1>;
			nvmem-cell-names = "mac-address";

			clocks = <&nsscc NSS_CC_PORT4_MAC_CLK>,
				 <&nsscc NSS_CC_PORT4_RX_CLK>,
				 <&nsscc NSS_CC_PORT4_TX_CLK>;
			clock-names = "mac", "rx", "tx";

			resets = <&nsscc PORT4_MAC_ARES>,
				 <&nsscc PORT4_RX_ARES>,
				 <&nsscc PORT4_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@5 {
			reg = <5>;
			phy-mode = "usxgmii";
			phy-handle = <&aqr113c>;
			pcs-handle = <&pcs1_ch0>;
			managed = "in-band-status";
			label = "wan";

			nvmem-cells = <&ethaddr 0>;
			nvmem-cell-names = "mac-address";

			clocks = <&nsscc NSS_CC_PORT5_MAC_CLK>,
				 <&nsscc NSS_CC_PORT5_RX_CLK>,
				 <&nsscc NSS_CC_PORT5_TX_CLK>;
			clock-names = "mac", "rx", "tx";

			resets = <&nsscc PORT5_MAC_ARES>,
				 <&nsscc PORT5_RX_ARES>,
				 <&nsscc PORT5_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};
	};
};

&blsp1_i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	status = "okay";

	/* Xiaomi NFC is a vendor driver; keep the address documented only. */
	nfc@54 {
		compatible = "miwifi,nfc";
		reg = <0x54>;
		status = "disabled";
	};
};

&blsp1_i2c3 {
	pinctrl-0 = <&i2c3_pins>;
	pinctrl-names = "default";
	status = "okay";

	temperature-sensor@4c {
		compatible = "national,lm63";
		reg = <0x4c>;
	};

	fan-controller@2f {
		compatible = "microchip,emc2305";
		reg = <0x2f>;
	};
};

&tlmm {
	leds_pins: leds-pins {
		sys-white {
			pins = "gpio40";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		sys-orange {
			pins = "gpio41";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		net-white {
			pins = "gpio42";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		net-orange {
			pins = "gpio43";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		sfp-green {
			pins = "gpio62";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	pwm_pins: pwm-pins {
		mux-1 {
			pins = "gpio31";
			function = "pwm11";
			drive-strength = <8>;
		};

		mux-2 {
			pins = "gpio32";
			function = "pwm21";
			drive-strength = <8>;
		};

		mux-3 {
			pins = "gpio33";
			function = "pwm31";
			drive-strength = <8>;
		};
	};

	button_pins: button-pins {
		mesh-button {
			pins = "gpio44";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};

		reset-button {
			pins = "gpio45";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_snand_pins: qpic-snand-pins {
		qspi-clock {
			pins = "gpio5";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		qspi-cs {
			pins = "gpio4";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		qspi-data {
			pins = "gpio0", "gpio1", "gpio2", "gpio3";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	i2c1_pins: i2c1-pins {
		pins = "gpio36", "gpio37";
		function = "blsp1_i2c";
		drive-strength = <8>;
		bias-disable;
	};

	i2c3_pins: i2c3-pins {
		pins = "gpio15", "gpio16";
		function = "blsp3_i2c";
		drive-strength = <8>;
		bias-disable;
	};

	/*
	 * The SoC DTSI references this label from the disabled SDHC node.
	 * Keep the group defined so the board DTB links even though this
	 * board boots from QPIC NAND.
	 */
	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio5";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio4";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio0", "gpio1", "gpio2",
				"gpio3", "gpio6", "gpio7",
				"gpio8", "gpio9";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};

		rclk-pins {
			pins = "gpio10";
			function = "sdc_rclk";
			drive-strength = <8>;
			bias-pull-down;
		};
	};
};

#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99
STOP=10
USE_PROCD=1

start_service() {
	. /lib/functions.sh
	[ "$(board_name)" = "xiaomi,be18000" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/be18000-fan
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

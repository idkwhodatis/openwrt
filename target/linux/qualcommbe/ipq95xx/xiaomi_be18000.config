# Buildroot seed configuration for the Xiaomi BE18000.
#
# A fresh tree only needs these selections; make defconfig fills in
# the target, package and image defaults.  See the Phase A/B/C build
# manifest for the complete build and artifact-verification steps.
#
#   cp target/linux/qualcommbe/ipq95xx/xiaomi_be18000.config .config
#   make defconfig
#   make REVISION=be18000 -j"$(nproc)" V=s

CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_xiaomi_be18000=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_PACKAGE_kmod-input-core=y

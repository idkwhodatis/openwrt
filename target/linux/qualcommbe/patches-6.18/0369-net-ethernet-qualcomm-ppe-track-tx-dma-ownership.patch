-{
-	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
-	struct edma_txdesc_pri *txd = NULL;
-	struct device *dev = ppe_dev->dev;
-	dma_addr_t buff_addr;
-	u32 buf_len = 0;
-
-	/* Get the packet length. */

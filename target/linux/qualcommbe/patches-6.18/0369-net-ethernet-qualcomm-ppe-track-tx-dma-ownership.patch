-					 skb_headlen(iter_skb), DMA_TO_DEVICE);
-			cnt_sg_frag_list += 1;
-		}
-
-		if (cnt_sg_frag_list == num_sg_frag_list)
-			return;
-
-		/* skb fraglist skb had nr_frags, unmap that memory. */
-		u32 nr_frags = skb_shinfo(iter_skb)->nr_frags;
-
-		if (nr_frags == 0)
-			continue;
-
-		for (int i = 0; i < nr_frags; i++) {
-			skb_frag_t *frag = &skb_shinfo(iter_skb)->frags[i];
-
-			/* DMA mapping was not done for zero size segments. */
-			if (unlikely(skb_frag_size(frag) == 0))
-				continue;
-
-			dma_unmap_page(dev, virt_to_phys(frag),
-				       PAGE_SIZE, DMA_TO_DEVICE);
-			cnt_sg_frag_list += 1;
-			if (cnt_sg_frag_list == num_sg_frag_list)
-				return;
-		}
+	struct edma_tx_skb_cb *cb = builder->cb;
+	struct edma_txdesc_pri *txd;
+	struct edma_tx_dma_map *map;
+
+	/* Record only successful mappings; the packet owns them until freed. */
+	map = cb->num_maps ? &cb->extra[cb->num_maps - 1] : &cb->first;
+	map->addr = addr;
+	map->len = len;
+	map->page = !!pool_id;
+	cb->num_maps++;
+
+	txd = EDMA_TXDESC_PRI_DESC(builder->ring, builder->next);
+	memset(txd, 0, sizeof(*txd));
+	EDMA_TXDESC_BUFFER_ADDR_SET(txd, addr);

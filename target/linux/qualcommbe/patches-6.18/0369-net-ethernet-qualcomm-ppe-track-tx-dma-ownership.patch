+struct edma_tx_desc_builder {
+	struct edma_port_priv *port_priv;
+	struct edma_txdesc_ring *ring;
+	struct edma_port_tx_stats *stats;
+	struct sk_buff *skb;
+	struct edma_tx_skb_cb *cb;

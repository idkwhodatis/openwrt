From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 22 Nov 2026 12:00:00 +0000
Subject: [PATCH] net: ethernet: qualcomm: ppe: track TX DMA ownership

The scatter-gather mapping path adds a helper's zero failure result to a
count already containing the head descriptor, so it can publish a partial
MORE chain after DMA mapping fails. Its error paths also reconstruct DMA
addresses from skb fragment metadata and unmap PAGE_SIZE instead of the
mapped length. Completion skips intermediate descriptors and unmaps only
one segment, leaking the other mappings even on successful transmission.

Record every successful mapping's DMA address, length and mapping type in
packet-owned storage. Keep the first mapping in skb->cb, with a build-time
size check; allocate only the additional records needed by a scattered
packet. This avoids a per-packet allocation for linear traffic and keeps
metadata valid when a TX descriptor is reused before completion.

Use one segment builder for skb heads, page fragments and direct frag-list
children. Skip empty segments, set MORE only after the next mapping has
succeeded, convert each descriptor to little endian once, and retain the
root skb opaque on the final descriptor only. Linearize nested frag lists
before counting or mapping so their payload is not silently omitted.
Unwind the complete successful mapping prefix on any error without
publishing a producer update or returning descriptor exhaustion. Reclaim
all mappings through the same helper on completion and pending-packet
teardown. Move packet statistics before producer publication so completion
cannot free an skb while the transmit path still reads it.

Skip hardware-index walks during allocation rollback until ring registers
have been configured. During live teardown, only unconsumed final TX
descriptors own packets; consumed final descriptors belong to their
completion ring. Correct the per-port ring-disable loop, which otherwise
overwrites the computed port index and disables port 1 for every port.
The existing hardware shutdown ordering and delay are unchanged.

Signed-off-by: Codex <codex@openai.com>
---
diff --git a/drivers/net/ethernet/qualcomm/ppe/edma_cfg_tx.c b/drivers/net/ethernet/qualcomm/ppe/edma_cfg_tx.c
index ae9f5dc..6de80ad 100644
--- a/drivers/net/ethernet/qualcomm/ppe/edma_cfg_tx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_cfg_tx.c
@@ -25,7 +25,8 @@ static void edma_cfg_txcmpl_ring_cleanup(struct edma_txcmpl_ring *txcmpl_ring)
 	struct device *dev =  ppe_dev->dev;
 
 	/* Free any buffers assigned to any descriptors. */
-	edma_tx_complete(EDMA_TX_RING_SIZE - 1, txcmpl_ring);
+	if (txcmpl_ring->configured)
+		edma_tx_complete(EDMA_TX_RING_SIZE - 1, txcmpl_ring);
 
 	/* Free Tx cmpl ring descriptors. */
 	dma_free_coherent(dev, sizeof(struct edma_txcmpl_desc)
@@ -33,6 +34,7 @@ static void edma_cfg_txcmpl_ring_cleanup(struct edma_txcmpl_ring *txcmpl_ring)
 			  txcmpl_ring->dma);
 	txcmpl_ring->desc = NULL;
 	txcmpl_ring->dma = (dma_addr_t)0;
+	txcmpl_ring->configured = false;
 }
 
 static int edma_cfg_txcmpl_ring_setup(struct edma_txcmpl_ring *txcmpl_ring)
@@ -61,6 +63,10 @@ static void edma_cfg_tx_desc_ring_cleanup(struct edma_txdesc_ring *txdesc_ring)
 	u32 prod_idx, cons_idx, data, reg;
 	struct sk_buff *skb = NULL;
 
+	/* Allocation rollback has no packets or initialized hardware indices. */
+	if (!txdesc_ring->configured)
+		goto free_desc;
+
 	/* Free any buffers assigned to any descriptors. */
 	reg = EDMA_BASE_OFFSET + EDMA_REG_TXDESC_PROD_IDX(txdesc_ring->id);
 	regmap_read(regmap, reg, &data);
@@ -70,15 +76,23 @@ static void edma_cfg_tx_desc_ring_cleanup(struct edma_txdesc_ring *txdesc_ring)
 	regmap_read(regmap, reg, &data);
 	cons_idx = data & EDMA_TXDESC_CONS_IDX_MASK;
 
-	/* Walk active list, obtain skb from descriptor and free it. */
+	/* The caller has stopped the ports and disabled their TX rings.
+	 * An unconsumed final descriptor owns the packet; a consumed final
+	 * descriptor transfers ownership to the completion ring instead.
+	 */
 	while (cons_idx != prod_idx) {
 		txdesc = EDMA_TXDESC_PRI_DESC(txdesc_ring, cons_idx);
-		skb = (struct sk_buff *)EDMA_TXDESC_OPAQUE_GET(txdesc);
-		dev_kfree_skb_any(skb);
+		if (!(le32_to_cpu((__force __le32)txdesc->word1) &
+		      EDMA_TXDESC_MORE_BIT_MASK)) {
+			skb = (struct sk_buff *)EDMA_TXDESC_OPAQUE_GET(txdesc);
+			edma_tx_free_skb(skb);
+			EDMA_TXDESC_OPAQUE_SET(txdesc, NULL);
+		}
 
 		cons_idx = ((cons_idx + 1) & EDMA_TX_RING_SIZE_MASK);
 	}
 
+free_desc:
 	/* Free Tx ring descriptors. */
 	dma_free_coherent(dev, (sizeof(struct edma_txdesc_pri)
 			  * txdesc_ring->count),
@@ -94,6 +108,7 @@ static void edma_cfg_tx_desc_ring_cleanup(struct edma_txdesc_ring *txdesc_ring)
 			  txdesc_ring->sdma);
 	txdesc_ring->sdesc = NULL;
 	txdesc_ring->sdma = (dma_addr_t)0;
+	txdesc_ring->configured = false;
 }
 
 static int edma_cfg_tx_desc_ring_setup(struct edma_txdesc_ring *txdesc_ring)
@@ -150,6 +165,7 @@ static void edma_cfg_tx_desc_ring_configure(struct edma_txdesc_ring *txdesc_ring
 	/* Configure group ID for flow control for this Tx ring. */
 	reg = EDMA_BASE_OFFSET + EDMA_REG_TXDESC_CTRL(txdesc_ring->id);
 	regmap_write(regmap, reg, data);
+	txdesc_ring->configured = true;
 }
 
 static void edma_cfg_txcmpl_ring_configure(struct edma_txcmpl_ring *txcmpl_ring)
@@ -205,6 +221,7 @@ static void edma_cfg_txcmpl_ring_configure(struct edma_txcmpl_ring *txcmpl_ring)
 
 	reg = EDMA_BASE_OFFSET + EDMA_REG_TX_INT_CTRL(txcmpl_ring->id);
 	regmap_write(regmap, reg, EDMA_TX_NE_INT_EN);
+	txcmpl_ring->configured = true;
 }
 
 /**
@@ -272,10 +289,9 @@ void edma_cfg_tx_rings_disable(u32 port_id)
 		txdesc_ring = &edma_ctx->tx_rings[ring_idx];
 		u32 data;
 
-		txdesc_ring = &edma_ctx->tx_rings[i];
 		reg = EDMA_BASE_OFFSET + EDMA_REG_TXDESC_CTRL(txdesc_ring->id);
 		regmap_read(regmap, reg, &data);
-		data &= ~EDMA_TXDESC_TX_ENABLE;
+		data &= ~EDMA_TXDESC_CTRL_TXEN_MASK;
 		regmap_write(regmap, reg, data);
 	}
 }

+		edma_tx_fill_desc(builder->port_priv, txd, builder->skb,
+				  builder->stats);
 	}
+
+	builder->last = txd;
+	builder->next = (builder->next + 1) & EDMA_TX_RING_SIZE_MASK;
 }
 

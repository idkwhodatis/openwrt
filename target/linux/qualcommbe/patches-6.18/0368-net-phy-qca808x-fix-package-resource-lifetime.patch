+/* Called with qca8084_package_lock held, on failed package acquisition or
+ * after the final PHY releases its package reference.
+ */
+static void qca8084_phy_package_release(struct qca808x_shared_priv *shared_priv)
+{
+	const unsigned int *clock_order = qca8084_package_clock_order;
+	int i;
+
+	qca8084_package_xpcs_and_pcs_remove(shared_priv->mdiodev[1],
+					    shared_priv->mdiodev[0]);
+	shared_priv->mdiodev[0] = NULL;
+	shared_priv->mdiodev[1] = NULL;
+
+	if (shared_priv->package_initialized) {
+		for (i = ARRAY_SIZE(qca8084_package_clock_order) - 1; i >= 0; i--)
+			clk_disable_unprepare(shared_priv->clk[clock_order[i]]);
+	}
+
+	reset_control_put(shared_priv->rstc);
+	shared_priv->rstc = NULL;
+	for (i = 0; i < ARRAY_SIZE(shared_priv->clk); i++) {
+		clk_put(shared_priv->clk[i]);
+		shared_priv->clk[i] = NULL;
+	}
+	shared_priv->package_prepared = false;
+	shared_priv->package_initialized = false;

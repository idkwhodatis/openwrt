 struct qca8084_xpcs_data {
@@ -175,6 +176,72 @@
 
 static const int qca8084_xpcs_ch_mmd[QCA8084_CHANNEL_MAX] = { 31, 26, 27, 28 };
 
+static const unsigned int qca8084_xpcs_clock_order[] = {
+	XPCS_RX_CLK, XPCS_TX_CLK, XPCS_PORT_RX_CLK, XPCS_PORT_TX_CLK,
+	XPCS_XGMII_RX_CLK, XPCS_XGMII_TX_CLK,
+};
+
+static void qca8084_xpcs_disable_clocks(struct qca8084_xpcs_channel_priv *ch)
+{
+	int i;
+
+	if (!ch->clocks_enabled)
+		return;
+
+	for (i = ARRAY_SIZE(qca8084_xpcs_clock_order) - 1; i >= 0; i--)
+		clk_disable_unprepare(ch->clks[qca8084_xpcs_clock_order[i]]);
+	ch->clocks_enabled = false;
+}
+
+static int qca8084_xpcs_enable_clocks(struct qca8084_xpcs_channel_priv *ch)
+{
+	int i, ret;
+
+	if (ch->clocks_enabled)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(qca8084_xpcs_clock_order); i++) {
+		ret = clk_prepare_enable(ch->clks[qca8084_xpcs_clock_order[i]]);
+		if (ret)
+			goto err_disable_clocks;
+	}
+	ch->clocks_enabled = true;
+	return 0;
+
+err_disable_clocks:
+	while (i--)
+		clk_disable_unprepare(ch->clks[qca8084_xpcs_clock_order[i]]);
+	return ret;
+}
+
+static void qca8084_pcs_free(struct qca8084_pcs_data *pcs_data)
+{
+	int i;
+
+	if (pcs_data->clock_enabled)
+		clk_disable_unprepare(pcs_data->clks[PCS_CLK]);
+	for (i = 0; i < ARRAY_SIZE(pcs_data->clks); i++)
+		clk_put(pcs_data->clks[i]);
+	reset_control_put(pcs_data->rstc);
+	kfree(pcs_data);
+}
+
+static void qca8084_xpcs_free(struct qca8084_xpcs_data *xpcs_data)
+{
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(xpcs_data->xpcs_ch); i++) {
+		struct qca8084_xpcs_channel_priv *ch = &xpcs_data->xpcs_ch[i];
+
+		qca8084_xpcs_disable_clocks(ch);
+		for (j = 0; j < ARRAY_SIZE(ch->clks); j++)
+			clk_put(ch->clks[j]);
+		reset_control_put(ch->rstcs);
+	}
+	reset_control_put(xpcs_data->rstc);
+	kfree(xpcs_data);
+}

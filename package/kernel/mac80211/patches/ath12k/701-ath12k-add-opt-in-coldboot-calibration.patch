From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt BE18000 port <openwrt@example.invalid>
Date: Sun, 22 Nov 2026 00:00:00 +0000
Subject: [PATCH] ath12k: add opt-in QCN9274 coldboot calibration

Add the QMI side of coldboot calibration for QCN9274 hw2.0 devices such
as the QCN9224 radios on the Xiaomi BE18000.  The implementation is
disabled by default and requires an explicit module parameter:

    ath12k.cold_boot_cal=1

When enabled, the driver waits for the first FW_READY, sends the WLAN INI
request, and sends calibration mode 7.  The 60-second CAL_DONE deadline
starts only after the mode-7 request is accepted, so firmware discovery,
memory negotiation and BDF transfer do not consume the calibration
budget.

The restart worker consumes the result and performs OFF, power-down,
power-up and the mission-mode restart even when CAL_DONE or a mode-request
failure landed before the worker was scheduled.  CAL_DONE is accepted
only while the active attempt is in the WAIT_CAL state and only when a
single CALDB target-memory chunk is still mapped.  An indication that
arrives before mode 7, after the deadline, or without retained CALDB is
ignored and the attempt falls back to mission mode.

The CALDB DMA allocation is retained across the reset.  A mission-mode
target-memory request must keep the same CALDB index, size, physical
address and backing; a replacement request is rejected and invalidates
the calibration result.  The mission HOST_CAP advertises cal_done=1 only
while both cal_done and the retained-CALDB flag are set.

Coldboot host-cap requests are issued per chip without MLO capabilities.
Group host-cap negotiation is deferred while any radio in the group is
still coldboot-pending, and mission-mode partner triggers skip pending
chips, so no radio receives a second HOST_CAP during calibration.  MLO
is advertised only after the whole group has completed calibration.

The reset runs from a work item rather than from the PCI probe or the
hardware-group lock.  The group lock protects target-memory allocation,
so waiting for CAL_DONE while holding it would deadlock against the QMI
memory-request worker.  Teardown cancels the work before HIF power-down
and before the QMI handle is released.

The default target-memory mode is required: the fixed-memory path does
not yet describe a CALDB reserved-memory region.  Only QCN9274 hw2.0 is
accepted.  Hardware validation of PCIe enumeration, firmware CAL_DONE
timing and MLO after coldboot is still required.

Signed-off-by: OpenWrt BE18000 port <openwrt@example.invalid>
---
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -5,10 +5,12 @@
  */
 
 #include <linux/elf.h>
+#include <linux/module.h>
 
 #include "qmi.h"
 #include "core.h"
 #include "debug.h"
+#include "hif.h"
 #include <linux/of.h>
 #include <linux/firmware.h>
 #include <linux/of_address.h>
@@ -19,6 +21,71 @@
 #define PLATFORM_CAP_PCIE_GLOBAL_RESET	0x08
 #define ATH12K_QMI_MAX_CHUNK_SIZE	2097152
 
+static bool ath12k_cold_boot_cal;
+module_param_named(cold_boot_cal, ath12k_cold_boot_cal, bool, 0444);
+MODULE_PARM_DESC(cold_boot_cal,
+		 "Enable QCN9274 coldboot calibration (default: disabled)");
+
+bool ath12k_qmi_cold_boot_pending(struct ath12k_base *ab)
+{
+	enum ath12k_qmi_cold_boot_state state =
+		READ_ONCE(ab->qmi.cold_boot_state);
+
+	return ab->qmi.cold_boot_cal &&
+	       state < ATH12K_QMI_COLD_BOOT_COMPLETE;
+}
+
+static void
+ath12k_qmi_cold_boot_invalidate_caldb_locked(struct ath12k_qmi *qmi)
+{
+	qmi->cal_done = 0;
+	qmi->caldb_valid = false;
+	qmi->caldb_idx = -1;
+	qmi->caldb_size = 0;
+	qmi->caldb_paddr = 0;
+}
+
+static void ath12k_qmi_cold_boot_invalidate_caldb(struct ath12k_base *ab)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&ab->qmi.cold_boot_lock, flags);
+	ath12k_qmi_cold_boot_invalidate_caldb_locked(&ab->qmi);
+	spin_unlock_irqrestore(&ab->qmi.cold_boot_lock, flags);
+}
+
+static bool ath12k_qmi_cold_boot_caldb_valid(struct ath12k_base *ab)
+{
+	unsigned long flags;
+	bool valid;
+
+	spin_lock_irqsave(&ab->qmi.cold_boot_lock, flags);
+	valid = ab->qmi.cal_done && ab->qmi.caldb_valid;
+	spin_unlock_irqrestore(&ab->qmi.cold_boot_lock, flags);
+
+	return valid;
+}
+
+static int ath12k_qmi_cold_boot_find_caldb(struct ath12k_qmi *qmi)
+{
+	int i, found = -1;
+
+	for (i = 0; i < qmi->mem_seg_count; i++) {
+		if (qmi->target_mem[i].type != CALDB_MEM_REGION_TYPE)
+			continue;
+
+		if (found >= 0)
+			return -EINVAL;
+
+		if (!qmi->target_mem[i].v.addr)
+			return -ENOENT;
+
+		found = i;
+	}
+
+	return found;
+}
+
 static const struct qmi_elem_info wlfw_host_mlo_chip_info_s_v01_ei[] = {
 	{
 		.data_type      = QMI_UNSIGNED_1_BYTE,
@@ -2015,6 +2082,32 @@
 	},
 };
 
+static const struct qmi_elem_info wlfw_cal_done_ind_msg_v01_ei[] = {
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x10,
+		.offset		= offsetof(struct wlfw_cal_done_ind_msg_v01,
+					   cal_file_upload_size_valid),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_8_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u64),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x10,
+		.offset		= offsetof(struct wlfw_cal_done_ind_msg_v01,
+					   cal_file_upload_size),
+	},
+	{
+		.data_type	= QMI_EOTI,
+		.array_type	= NO_ARRAY,
+		.tlv_type	= QMI_COMMON_TLV_TYPE,
+	},
+};
+
 static const struct qmi_elem_info qmi_wlanfw_wlan_ini_req_msg_v01_ei[] = {
 	{
 		.data_type	= QMI_OPT_FLAG,
@@ -2092,6 +2185,12 @@
 	u8 hw_link_id = 0;
 	int i, j, ret;
 
+	if (ath12k_qmi_cold_boot_pending(ab)) {
+		ath12k_dbg(ab, ATH12K_DBG_QMI,
+			   "skip QMI MLO cap during coldboot calibration\n");
+		return 0;
+	}
+
 	if (!ag->mlo_capable) {
 		ath12k_dbg(ab, ATH12K_DBG_QMI,
 			   "MLO is disabled hence skip QMI MLO cap");
@@ -2219,7 +2318,7 @@
 	}
 
 	req.cal_done_valid = 1;
-	req.cal_done = ab->qmi.cal_done;
+	req.cal_done = ath12k_qmi_cold_boot_caldb_valid(ab);
 
 	if (ab->hw_params->qmi_cnss_feature_bitmap) {
 		req.feature_list_valid = 1;
@@ -2579,6 +2678,8 @@
 		ag->mlo_mem.init_done = false;
 		ag->mlo_mem.mlo_mem_size = 0;
 	}
+
+	ath12k_qmi_cold_boot_invalidate_caldb(ab);
 }
 
 static int ath12k_qmi_alloc_chunk(struct ath12k_base *ab,
@@ -2626,11 +2727,27 @@
 {
 	struct target_mem_chunk *chunk, *mlo_chunk;
 	struct ath12k_hw_group *ag = ab->ag;
+	unsigned long flags;
 	int i, mlo_idx, ret;
 	int mlo_size = 0;
 
 	mutex_lock(&ag->mutex);
 
+	spin_lock_irqsave(&ab->qmi.cold_boot_lock, flags);
+	if (ab->qmi.caldb_valid &&
+	    (ab->qmi.caldb_idx < 0 ||
+	     ab->qmi.caldb_idx >= ab->qmi.mem_seg_count ||
+	     ab->qmi.target_mem[ab->qmi.caldb_idx].type != CALDB_MEM_REGION_TYPE ||
+	     ab->qmi.target_mem[ab->qmi.caldb_idx].size != ab->qmi.caldb_size ||
+	     ab->qmi.target_mem[ab->qmi.caldb_idx].paddr != ab->qmi.caldb_paddr ||
+	     !ab->qmi.target_mem[ab->qmi.caldb_idx].v.addr)) {
+		spin_unlock_irqrestore(&ab->qmi.cold_boot_lock, flags);
+		ath12k_err(ab, "rejecting incompatible CALDB target-memory request\n");
+		ret = -EINVAL;
+		goto err;
+	}
+	spin_unlock_irqrestore(&ab->qmi.cold_boot_lock, flags);
+
 	if (!ag->mlo_mem.init_done) {
 		memset(ag->mlo_mem.chunk, 0, sizeof(ag->mlo_mem.chunk));
 		ag->mlo_mem.init_done = true;
@@ -3633,6 +3750,142 @@
 	return 0;
 }
 
+static void ath12k_qmi_cold_boot_work(struct work_struct *work)
+{
+	struct ath12k_qmi *qmi = container_of(work, struct ath12k_qmi,
+					      cold_boot_work);
+	struct ath12k_base *ab = qmi->ab;
+	unsigned long timeout;
+	unsigned long flags;
+	bool success = false;
+	int ret;
+
+	spin_lock_irqsave(&qmi->cold_boot_lock, flags);
+	if (!qmi->cold_boot_cal ||
+	    qmi->cold_boot_state != ATH12K_QMI_COLD_BOOT_IDLE) {
+		spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+		return;
+	}
+	spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+
+	ath12k_dbg(ab, ATH12K_DBG_QMI, "coldboot waiting for FW_READY\n");
+	wait_for_completion(&qmi->fw_ready_completion);
+	if (READ_ONCE(qmi->cold_boot_cancelled))
+		return;
+
+	ret = ath12k_qmi_wlanfw_wlan_ini_send(ab);
+	if (ret) {
+		ath12k_warn(ab, "coldboot wlan ini request failed: %d\n", ret);
+		goto fail;
+	}
+
+	spin_lock_irqsave(&qmi->cold_boot_lock, flags);
+	if (qmi->cold_boot_cancelled) {
+		spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+		return;
+	}
+	qmi->cold_boot_state = ATH12K_QMI_COLD_BOOT_WAIT_CAL;
+	spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+
+	ret = ath12k_qmi_wlanfw_mode_send(ab,
+					  ATH12K_FIRMWARE_MODE_CALIBRATION);
+	if (ret) {
+		ath12k_warn(ab, "coldboot mode request failed: %d\n", ret);
+		goto fail;
+	}
+
+	ath12k_info(ab, "coldboot mode 7 accepted; waiting for CAL_DONE\n");
+	timeout = wait_for_completion_timeout(&qmi->cal_done_completion,
+					      msecs_to_jiffies(ATH12K_COLD_BOOT_TIMEOUT_MS));
+
+	spin_lock_irqsave(&qmi->cold_boot_lock, flags);
+	if (qmi->cold_boot_cancelled) {
+		spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+		return;
+	}
+
+	if (timeout && qmi->cal_done && qmi->caldb_valid) {
+		success = true;
+	} else {
+		qmi->cal_timeout = true;
+		ath12k_qmi_cold_boot_invalidate_caldb_locked(qmi);
+	}
+	qmi->cold_boot_state = ATH12K_QMI_COLD_BOOT_RESET;
+	spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+
+	if (!success && !timeout)
+		ath12k_warn(ab, "coldboot calibration timed out\n");
+	else if (!success)
+		ath12k_warn(ab, "coldboot CAL_DONE without a valid CALDB\n");
+
+	goto reset;
+
+fail:
+	spin_lock_irqsave(&qmi->cold_boot_lock, flags);
+	if (qmi->cold_boot_cancelled) {
+		spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+		return;
+	}
+	qmi->cal_timeout = true;
+	ath12k_qmi_cold_boot_invalidate_caldb_locked(qmi);
+	qmi->cold_boot_state = ATH12K_QMI_COLD_BOOT_RESET;
+	spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+
+reset:
+	/* Keep target_mem[] mapped: the CALDB DMA buffer holds the
+	 * calibration result consumed by the mission-mode boot.
+	 */
+	ath12k_info(ab, "restarting firmware after coldboot (%s)\n",
+		    success ? "calibrated" : "fallback");
+	ath12k_qmi_firmware_stop(ab);
+	ath12k_hif_power_down(ab, false);
+
+	if (READ_ONCE(qmi->cold_boot_cancelled))
+		return;
+
+	spin_lock_irqsave(&qmi->cold_boot_lock, flags);
+	qmi->cold_boot_state = success ?
+		ATH12K_QMI_COLD_BOOT_COMPLETE : ATH12K_QMI_COLD_BOOT_FAILED;
+	spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+
+	ret = ath12k_hif_power_up(ab);
+	if (ret)
+		ath12k_err(ab, "failed to power up after coldboot: %d\n", ret);
+}
+
+void ath12k_qmi_schedule_cold_boot(struct ath12k_base *ab)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&ab->qmi.cold_boot_lock, flags);
+	if (!ab->qmi.cold_boot_cal ||
+	    ab->qmi.cold_boot_state != ATH12K_QMI_COLD_BOOT_IDLE) {
+		spin_unlock_irqrestore(&ab->qmi.cold_boot_lock, flags);
+		return;
+	}
+	spin_unlock_irqrestore(&ab->qmi.cold_boot_lock, flags);
+
+	queue_work(system_wq, &ab->qmi.cold_boot_work);
+}
+
+void ath12k_qmi_cancel_cold_boot(struct ath12k_base *ab)
+{
+	unsigned long flags;
+
+	if (!ab->qmi.ab)
+		return;
+
+	spin_lock_irqsave(&ab->qmi.cold_boot_lock, flags);
+	ab->qmi.cold_boot_cancelled = true;
+	if (ab->qmi.cold_boot_state < ATH12K_QMI_COLD_BOOT_COMPLETE)
+		ab->qmi.cold_boot_state = ATH12K_QMI_COLD_BOOT_CANCELLED;
+	spin_unlock_irqrestore(&ab->qmi.cold_boot_lock, flags);
+
+	complete_all(&ab->qmi.fw_ready_completion);
+	complete_all(&ab->qmi.cal_done_completion);
+	cancel_work_sync(&ab->qmi.cold_boot_work);
+}
+
 static int
 ath12k_qmi_driver_event_post(struct ath12k_qmi *qmi,
 			     enum ath12k_qmi_event_type type,
@@ -3683,6 +3936,9 @@
 
 		if (!(ab && ab->qmi.num_radios != U8_MAX))
 			return false;
+
+		if (ath12k_qmi_cold_boot_pending(ab))
+			return false;
 	}
 
 	return true;
@@ -3729,6 +3985,11 @@
 		return ret;
 	}
 
+	if (ath12k_qmi_cold_boot_pending(ab)) {
+		ath12k_qmi_trigger_host_cap(ab);
+		return ret;
+	}
+
 	spin_lock(&qmi->event_lock);
 
 	ath12k_qmi_set_event_block(qmi, true);
@@ -3884,6 +4145,49 @@
 	ath12k_qmi_driver_event_post(qmi, ATH12K_QMI_EVENT_FW_READY, NULL);
 }
 
+static void ath12k_qmi_msg_cal_done_cb(struct qmi_handle *qmi_hdl,
+				       struct sockaddr_qrtr *sq,
+				       struct qmi_txn *txn,
+				       const void *data)
+{
+	struct ath12k_qmi *qmi = container_of(qmi_hdl, struct ath12k_qmi,
+					      handle);
+	struct ath12k_base *ab = qmi->ab;
+	const struct wlfw_cal_done_ind_msg_v01 *ind = data;
+	unsigned long flags;
+	int idx, ret = 0;
+
+	ath12k_dbg(ab, ATH12K_DBG_QMI,
+		   "qmi coldboot calibration done, cal file size %llu\n",
+		   ind->cal_file_upload_size_valid ?
+		   (unsigned long long)ind->cal_file_upload_size : 0ULL);
+
+	spin_lock_irqsave(&qmi->cold_boot_lock, flags);
+	if (!qmi->cold_boot_cal || qmi->cal_done ||
+	    qmi->cal_timeout ||
+	    qmi->cold_boot_state != ATH12K_QMI_COLD_BOOT_WAIT_CAL)
+		goto out;
+
+	idx = ath12k_qmi_cold_boot_find_caldb(qmi);
+	if (idx < 0) {
+		qmi->cal_timeout = true;
+		complete_all(&qmi->cal_done_completion);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	qmi->caldb_idx = idx;
+	qmi->caldb_size = qmi->target_mem[idx].size;
+	qmi->caldb_paddr = qmi->target_mem[idx].paddr;
+	qmi->caldb_valid = true;
+	qmi->cal_done = 1;
+	complete(&qmi->cal_done_completion);
+out:
+	spin_unlock_irqrestore(&qmi->cold_boot_lock, flags);
+	if (ret)
+		ath12k_warn(ab, "coldboot CAL_DONE ignored: no single retained CALDB target-memory segment\n");
+}
+
 static const struct qmi_msg_handler ath12k_qmi_msg_handlers[] = {
 	{
 		.type = QMI_INDICATION,
@@ -3906,6 +4210,13 @@
 		.decoded_size = sizeof(struct qmi_wlanfw_fw_ready_ind_msg_v01),
 		.fn = ath12k_qmi_msg_fw_ready_cb,
 	},
+	{
+		.type = QMI_INDICATION,
+		.msg_id = QMI_WLFW_CAL_DONE_IND_V01,
+		.ei = wlfw_cal_done_ind_msg_v01_ei,
+		.decoded_size = sizeof(struct wlfw_cal_done_ind_msg_v01),
+		.fn = ath12k_qmi_msg_cal_done_cb,
+	},
 
 	/* end of list */
 	{},
@@ -4014,6 +4325,11 @@
 				break;
 			}
 
+			if (ath12k_qmi_cold_boot_pending(ab)) {
+				complete(&ab->qmi.fw_ready_completion);
+				break;
+			}
+
 			clear_bit(ATH12K_FLAG_CRASH_FLUSH,
 				  &ab->dev_flags);
 			ret = ath12k_core_qmi_firmware_ready(ab);
@@ -4046,6 +4362,20 @@
 	memset(&ab->qmi.target, 0, sizeof(struct target_info));
 	memset(&ab->qmi.target_mem, 0, sizeof(struct target_mem_chunk));
 	ab->qmi.ab = ab;
+	spin_lock_init(&ab->qmi.cold_boot_lock);
+	init_completion(&ab->qmi.fw_ready_completion);
+	init_completion(&ab->qmi.cal_done_completion);
+	ab->qmi.cold_boot_state = ATH12K_QMI_COLD_BOOT_IDLE;
+	ab->qmi.cold_boot_cancelled = false;
+	ab->qmi.cal_done = 0;
+	ab->qmi.cal_timeout = false;
+	ab->qmi.caldb_valid = false;
+	ab->qmi.caldb_idx = -1;
+	ab->qmi.caldb_size = 0;
+	ab->qmi.caldb_paddr = 0;
+	ab->qmi.cold_boot_cal = ath12k_cold_boot_cal &&
+		ab->target_mem_mode == ATH12K_QMI_MEMORY_MODE_DEFAULT &&
+		ab->hw_rev == ATH12K_HW_QCN9274_HW20;
 
 	ab->qmi.target_mem_mode = ab->target_mem_mode;
 	ret = qmi_handle_init(&ab->qmi.handle, ATH12K_QMI_RESP_LEN_MAX,
@@ -4064,6 +4394,7 @@
 	INIT_LIST_HEAD(&ab->qmi.event_list);
 	spin_lock_init(&ab->qmi.event_lock);
 	INIT_WORK(&ab->qmi.event_work, ath12k_qmi_driver_event_work);
+	INIT_WORK(&ab->qmi.cold_boot_work, ath12k_qmi_cold_boot_work);
 
 	ret = qmi_add_lookup(&ab->qmi.handle, QMI_SERVICE_ID_WLFW,
 			     ATH12K_QMI_WLFW_SERVICE_VERS_V01,
@@ -4082,6 +4413,7 @@
 	if (!ab->qmi.ab)
 		return;
 
+	ath12k_qmi_cancel_cold_boot(ab);
 	qmi_handle_release(&ab->qmi.handle);
 	cancel_work_sync(&ab->qmi.event_work);
 	destroy_workqueue(ab->qmi.event_wq);
--- a/drivers/net/wireless/ath/ath12k/qmi.h
+++ b/drivers/net/wireless/ath/ath12k/qmi.h
@@ -7,6 +7,7 @@
 #ifndef ATH12K_QMI_H

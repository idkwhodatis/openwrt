+
+enum ath12k_qmi_cold_boot_state {
+	ATH12K_QMI_COLD_BOOT_IDLE,
+	ATH12K_QMI_COLD_BOOT_WAIT_CAL,
+	ATH12K_QMI_COLD_BOOT_RESET,
+	ATH12K_QMI_COLD_BOOT_COMPLETE,
+	ATH12K_QMI_COLD_BOOT_FAILED,
+	ATH12K_QMI_COLD_BOOT_CANCELLED,
+};

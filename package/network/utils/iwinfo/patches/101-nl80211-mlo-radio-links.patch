 {
 	struct stat st;
@@ -811,9 +829,42 @@
 	return NULL;
 }
 
+static bool nl80211_select_mlo_link(struct nlattr **tb, int radio_idx,
+                                    struct nlattr **link_tb)
+{
+	struct nlattr *link, *cur_tb[NL80211_ATTR_MAX + 1];
+	int rem;
+	bool found = false;
+
+	if (!tb[NL80211_ATTR_MLO_LINKS])
+		return false;
+
+	nla_for_each_nested(link, tb[NL80211_ATTR_MLO_LINKS], rem) {
+		if (nla_parse_nested(cur_tb, NL80211_ATTR_MAX, link, NULL))
+			continue;
+
+		if (radio_idx >= 0) {
+			if (!cur_tb[NL80211_ATTR_MLO_LINK_ID] ||
+			    nla_get_u8(cur_tb[NL80211_ATTR_MLO_LINK_ID]) != (uint8_t)radio_idx)
+				continue;
+			memcpy(link_tb, cur_tb, sizeof(cur_tb));
+			return true;
+		}
+
+		if (!found && cur_tb[NL80211_ATTR_WIPHY_FREQ]) {
+			memcpy(link_tb, cur_tb, sizeof(cur_tb));
+			found = true;
+		}
+	}
+
+	return found;
+}

 static int nl80211_get_if_data(const char *ifname, struct nl80211_if_data *data)
 {
 	char *res;
+	int uci_radio;
 
 	res = nl80211_phy2ifname(ifname);
+	uci_radio = nl80211_radio_idx_from_uci(ifname);
 
 	data->mode = IWINFO_OPMODE_UNKNOWN;
 	data->radio_idx = -1;
